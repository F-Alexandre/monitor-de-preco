{

    "manifest_version":3,
    "name":"Monitor de Preco do Ps5 multisites",
    "version":"3.0",
    "description":"Monitora multiplos produtos e sites em segundo plano",
    "permissions":[
        "activeTab",
        "scripting",
        "storage",
        "alarms",
        "notifications"
    ],
    "host_permissions":[
       "https://*.mercadolivre.com.br/*",
       "https://*.amazon.com.br/*"
    ],
    "background":{
      "service_worker":"background.js "
    },

    "action":{
        "default_popup":"popup.html",
        "default_icon":"icon.png"
    },
    "icons":{
        "128":"icon.png"
    }
}