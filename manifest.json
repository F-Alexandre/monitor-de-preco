{

    "manifest_version":3,
    "name":"Monitor de Preco do Ps5 multisites",
    "version":"3.0",
    "description":"Monitora multiplos produtos e sites em segundo plano",
    "permissions":[
        "activeTab",
        "scripting",
        "storage",
        "alarms",
        "notifications"
    ],
    "host_permissions":[
       "https://*/*"
    ],
    "background":{
      "service_worker":"background.js "
    },

    "action":{
        "default_popup":"popup.html"
    }
}